# docker/Dockerfile.mlflow
#
# Custom MLflow tracking server image.
# MLflow server runs on port 5000 inside the container (mapped to 5001 on host).

FROM python:3.11-slim

# Install MLflow, PostgreSQL adapter, and S3-compatible storage support
RUN pip install --no-cache-dir \
    "mlflow==2.13.2" \
    "sqlalchemy==2.0.30" \
    "alembic==1.13.1" \
    "psycopg2-binary==2.9.9" \
    "boto3==1.34.131"

EXPOSE 5000

CMD ["mlflow", "server"]
