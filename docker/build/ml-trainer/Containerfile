# docker/build/ml-trainer/Containerfile
#
# One-shot fraud-model trainer. Kept separate from the Streamlit image because
# mlflow (protobuf<5) conflicts with Streamlit (protobuf>=5.26).
# Code is volume-mounted at runtime (see docker-compose.yml):
#   ./mlflow -> /mlflow_scripts   ./storage -> /storage   ./lineage -> /lineage

FROM python:3.11-slim

WORKDIR /mlflow_scripts

COPY requirements.txt /tmp/requirements.txt
RUN pip install --no-cache-dir --default-timeout=120 --retries 8 -r /tmp/requirements.txt

ENV PYTHONPATH=/ \
    MPLBACKEND=Agg

CMD ["python", "train_fraud_model.py", "--wait", "1800"]
