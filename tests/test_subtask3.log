MANUAL STEPS TO START FLINK AND SUBMIT JOBS
---------------------------------------------
# 1. Build the Flink image (one-time, uses RUN wget — no DNS issue)
podman build -t flink-custom:1.18 ./docker/build/flink/

# 2. Start Flink cluster and SQL client container
make flink-up
# Wait ~30s for jobmanager to be ready
# Verify: http://localhost:8081 shows Flink UI

# 3. Verify flink-sql-client is alive
podman exec flink-sql-client echo "alive"

# 4. Submit all 5 SQL jobs
make submit-sql
# Expected output: 5x [OK] lines

# 5. Verify in Flink UI: http://localhost:8081/#/jobs/running
# Should show 5 jobs: job_01 through job_05

# 6. Start KPI poller
make kpi-poller-up
make kpi-poller-logs
# Expected: "Cached N KPI window(s) in Redis"

# 7. Verify Redis keys
podman exec redis redis-cli KEYS "tax:kpi:*"
podman exec redis redis-cli HGETALL "tax:kpi:latest"

